# ============================================================
# Personal Video Studio — variables de entorno
# Copia este archivo a .env (local) y configura las mismas
# variables en Vercel: Project → Settings → Environment Variables.
# NUNCA subas secretos al repositorio.
# ============================================================

# --- Redis (Upstash vía Vercel Marketplace) ---
# Se rellenan AUTOMÁTICAMENTE al crear el Storage "Upstash Redis"
# y conectarlo al proyecto en el panel de Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Vercel Blob ---
# Se rellena AUTOMÁTICAMENTE al crear el Blob Store y conectarlo.
# IMPORTANTE: el store debe crearse con acceso PÚBLICO (no privado),
# o las subidas fallarán con "Cannot use public access on a private store".
BLOB_READ_WRITE_TOKEN=

# --- Administrador (un único admin, sin registro público) ---
# Genera el hash con:  npm run hash-password -- "tu-contraseña-segura"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Secreto aleatorio de 32+ caracteres para firmar la sesión (cookie HttpOnly).
# Genera uno con:  npm run hash-password -- "x"   (imprime también un secreto)
ADMIN_SESSION_SECRET=

# --- URL pública (opcional) ---
# Se usa para las etiquetas Open Graph al compartir en WhatsApp/redes.
# Si se deja vacía, se detecta automáticamente del host.
PUBLIC_URL=https://tu-proyecto.vercel.app
